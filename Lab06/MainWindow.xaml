<Window x:Class="Lab06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab06"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFF5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#FF1F3A5F" Padding="18">
            <StackPanel>
                <TextBlock Text="Clientes"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8" />
                <TextBlock Text="Selecciona una opción del CRUD"
                           TextWrapping="Wrap"
                           Foreground="#FFD9E2EC"
                           Margin="0,0,0,24" />

                <Button Content="Listar"
                        Height="42"
                        Margin="0,0,0,12"
                        Click="BtnListar_Click" />
                <Button Content="Agregar"
                        Height="42"
                        Margin="0,0,0,12"
                        />
                <Button Content="Actualizar"
                        Height="42"
                        Margin="0,0,0,12"
                         />
                <Button Content="Eliminar"
                        Height="42"
                        />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitulo"
                           Text="Gestión de clientes"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#FF1F2937" />
            </Border>

            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window>
